-- NPC Cache (обновляется по событиям, не каждый фрейм)
-- ============================================================

local CachedNPCs = {}
local LockPartCache = Environment and Environment.Settings and Environment.Settings.LockPart or "Head"

local function RebuildNPCCache()
    CachedNPCs = {}
    local playerChars = {}
    for _, p in next, GetPlayers(Players) do
        local c = __index(p, "Character")
        if c then playerChars[c] = true end
    end

    for _, obj in next, GetDescendants(workspace) do
        if obj.ClassName == "Humanoid" then
            local char = obj.Parent
            if not playerChars[char] then
                local part = FindFirstChild(char, LockPartCache) or FindFirstChild(char, "HumanoidRootPart")
                if part then
                    table.insert(CachedNPCs, {character = char, part = part})
                end
            end
        end
    end
end

-- Перестраиваем кэш при изменениях workspace
workspace.DescendantAdded:Connect(function(obj)
    if obj.ClassName == "Humanoid" then
        task.defer(RebuildNPCCache)
    end
end)

workspace.DescendantRemoving:Connect(function(obj)
    if obj.ClassName == "Humanoid" then
        task.defer(RebuildNPCCache)
    end
end)

-- Первоначальное заполнение
RebuildNPCCache()

-- Собираем все возможные таргеты (игроки + боты)
local GetAllTargets = LPH_NO_VIRTUALIZE(function()
    local Settings = Environment.Settings
    local LockPart = Settings.LockPart
    local TeamCheckOption = Environment.DeveloperSettings.TeamCheckOption
    local targets = {}

    -- Игроки
    if Settings.AimPlayers then
        for _, Value in next, GetPlayers(Players) do
            local Character = __index(Value, "Character")
            local Humanoid = Character and FindFirstChildOfClass(Character, "Humanoid")

            if Value ~= LocalPlayer
                and not tablefind(Environment.Blacklisted, __index(Value, "Name"))
                and Character
                and FindFirstChild(Character, LockPart)
                and Humanoid
            then
                if Settings.TeamCheck and __index(Value, TeamCheckOption) == __index(LocalPlayer, TeamCheckOption) then
                    continue
                end
                if Settings.AliveCheck and __index(Humanoid, "Health") <= 0 then
                    continue
                end
                if Settings.WallCheck then
                    local PartPosition = __index(Character[LockPart], "Position")
                    local BlacklistTable = GetDescendants(__index(LocalPlayer, "Character"))
                    for _, _Value in next, GetDescendants(Character) do
                        BlacklistTable[#BlacklistTable + 1] = _Value
                    end
                    if #GetPartsObscuringTarget(Camera, {PartPosition}, BlacklistTable) > 0 then
                        continue
                    end
                end
                -- Передаём как {type="player", object=Value}
                table.insert(targets, {type = "player", object = Value, character = Character})
            end
        end
    end

    -- Боты / NPC
-- Боты / NPC (оптимизировано: кэш вместо GetDescendants каждый фрейм)
if Settings.AimBots then
    local playerChars = {}
    for _, p in next, GetPlayers(Players) do
        local c = __index(p, "Character")
        if c then playerChars[c] = true end
    end

    for _, target in next, CachedNPCs do
        local char = target.character
        local part = target.part

        -- Проверяем что объект ещё существует
        if not char or not char.Parent then continue end
        if not part or not part.Parent then continue end
        if playerChars[char] then continue end

        local hum = FindFirstChildOfClass(char, "Humanoid")
        if not hum then continue end

        if Settings.AliveCheck and __index(hum, "Health") <= 0 then continue end

        if Settings.WallCheck then
            local PartPosition = __index(part, "Position")
            local BlacklistTable = GetDescendants(__index(LocalPlayer, "Character"))
            if #GetPartsObscuringTarget(Camera, {PartPosition}, BlacklistTable) > 0 then continue end
        end

        table.insert(targets, {type = "npc", object = hum, character = char, part = part})
    end
end

-- Получить часть тела таргета
local GetTargetPart = LPH_NO_VIRTUALIZE(function(target)
    local LockPart = Environment.Settings.LockPart
    if target.type == "player" then
        return FindFirstChild(target.character, LockPart)
    else
        return target.part
    end
end)

-- Получить имя таргета для LockLabel
local GetTargetName = LPH_NO_VIRTUALIZE(function(target)
    if target.type == "player" then
        return __index(target.object, "Name")
    else
        return target.character.Name .. " [NPC]"
    end
end)

local GetClosestTarget = LPH_NO_VIRTUALIZE(function(Aux)
    local FOVSettings = Environment.FOVSettings
    local Settings = Environment.Settings

    if not Environment.Locked or Aux then
        local ScreenFOV = FOVSettings.Enabled and FOVSettings.Radius or 2000
        local Best3DDistance = math.huge
        local BestTarget = nil

        local CameraPos = __index(Camera, "CFrame").Position
        local MousePos = GetMouseLocation(UserInputService)

        for _, target in next, GetAllTargets() do
            local part = GetTargetPart(target)
            if not part then continue end

            local PartPosition = __index(part, "Position")
            local ScreenVector, OnScreen = WorldToViewportPoint(Camera, PartPosition)
            if not OnScreen then continue end

            local ScreenPos2D = Vector2new(ScreenVector.X, ScreenVector.Y)
            local ScreenDist = (MousePos - ScreenPos2D).Magnitude
            if ScreenDist > ScreenFOV then continue end

            local WorldDist = (CameraPos - PartPosition).Magnitude
            if WorldDist < Best3DDistance then
                Best3DDistance = WorldDist
                BestTarget = target
            end
        end

        if BestTarget then
            if not Aux then
                Environment.Locked = BestTarget
                LockLabel.Text = "Target: " .. GetTargetName(BestTarget)
                LockLabel.TextColor3 = Color3fromRGB(100, 255, 100)
            elseif not Running and not Environment.Locked then
                return BestTarget
            end
        end

    else
        -- Проверяем живой ли залоченный таргет
        local LockPart_ = Settings.LockPart
        local locked = Environment.Locked
        local lockedChar = locked.character or (locked.type == "player" and __index(locked.object, "Character"))

        if not lockedChar or not FindFirstChild(lockedChar, LockPart_) then
            CancelLock()
            return
        end

        local LockedPos = __index(lockedChar[LockPart_], "Position")
        local ScreenVec, OnScreen = WorldToViewportPoint(Camera, LockedPos)
        local ScreenPos2D = Vector2new(ScreenVec.X, ScreenVec.Y)
        local MousePos = GetMouseLocation(UserInputService)
        local ScreenFOV = FOVSettings.Enabled and FOVSettings.Radius or 2000

        if not OnScreen or (MousePos - ScreenPos2D).Magnitude > ScreenFOV then
            CancelLock()
        end
    end
end)

-- Обёртка для совместимости с оригинальным GetClosestPlayer
local GetClosestPlayer = LPH_NO_VIRTUALIZE(function(Aux)
    return GetClosestTarget(Aux)
end)

