-- Слайдер FOV
local SliderDragging = false
local MIN_FOV, MAX_FOV = 30, 600

local function UpdateSlider(inputX)
    local bgPos = SliderBg.AbsolutePosition.X
    local bgSize = SliderBg.AbsoluteSize.X
    local rel = math.clamp((inputX - bgPos) / bgSize, 0, 1)
    local newRadius = math.floor(MIN_FOV + rel * (MAX_FOV - MIN_FOV))

    Environment.FOVSettings.Radius = newRadius
    FovLabel.Text = "FOV Radius: " .. newRadius
    SliderFill.Size = UDim2.new(rel, 0, 1, 0)
end

SliderBg.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        SliderDragging = true
        UpdateSlider(input.Position.X)
    end
end)

SliderBg.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        SliderDragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if SliderDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        UpdateSlider(input.Position.X)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        SliderDragging = false
    end
end)

