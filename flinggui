local function ToggleAll(select)
    for _, p in ipairs(Players:GetPlayers()) do
        if p == Player then continue end
        local data = PlayerCheckboxes[p.Name]
        if data then
            if select then
                SelectedTargets[p.Name] = p
                data.Checkmark.Visible = true
                data.CB.BackgroundColor3 = Color3.fromRGB(30, 80, 30)
            else
                SelectedTargets[p.Name] = nil
                data.Checkmark.Visible = false
                data.CB.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
            end
        end
    end
    UpdateStatus()
end

