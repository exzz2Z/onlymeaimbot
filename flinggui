-- ============================================================
-- ЯДРО ФЛИНГА
-- Bypass antifling: используем Attachment + VectorForce
-- напрямую на BasePart цели вместо телепорта к ней.
-- Это даёт физический удар который не блокируется
-- скриптами antifling основанными на детекте телепорта.
-- ============================================================
local function HardFling(target)
    local myChar = Player.Character
    local myHum  = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local myRoot = myHum and myHum.RootPart
    if not myRoot then return false end

    local tChar = target.Character
    if not tChar then return false end

    local tRoot = tChar:FindFirstChild("HumanoidRootPart")
    local tHum  = tChar:FindFirstChildOfClass("Humanoid")
    if not tRoot or not tHum then return false end

    -- Сохраняем позицию
    if myRoot.Velocity.Magnitude < 50 then
        getgenv().OldPos = myRoot.CFrame
    end

    -- Телепортируемся вплотную к цели
    myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 1.5)
    task.wait()

    -- Основной флинг — прямой импульс на RootPart цели
    -- Работает даже с antifling т.к. не зависит от их детекта
    local power = FlingPower
    tRoot.Velocity    = Vector3.new(power, power * 2, power)
    tRoot.RotVelocity = Vector3.new(power, power, power)

    -- Дополнительный удар через BodyVelocity на все BasePart
    if BypassEnabled then
        for _, part in ipairs(tChar:GetDescendants()) do
            if part:IsA("BasePart") and part ~= tRoot then
                pcall(function()
                    part.Velocity    = Vector3.new(power, power * 2, power)
                    part.RotVelocity = Vector3.new(power, power, power)
                end)
            end
        end

        -- VectorForce на 0.15с — бьёт через antifling защиту
        local att0 = Instance.new("Attachment")
        att0.Parent = tRoot

        local vf = Instance.new("VectorForce")
        vf.Attachment0 = att0
        vf.Force = Vector3.new(power * 500, power * 1000, power * 500)
        vf.ApplyAtCenterOfMass = true
        vf.RelativeTo = Enum.ActuatorRelativeTo.World
        vf.Parent = tRoot

        task.delay(0.15, function()
            pcall(function() vf:Destroy() end)
            pcall(function() att0:Destroy() end)
        end)
    end

    -- Возврат на место
    task.spawn(function()
        task.wait(0.2)
        if getgenv().OldPos and myRoot then
            local attempts = 0
            repeat
                attempts += 1
                myRoot.CFrame = getgenv().OldPos * CFrame.new(0, 0.5, 0)
                myChar:SetPrimaryPartCFrame(getgenv().OldPos * CFrame.new(0, 0.5, 0))
                myHum:ChangeState(Enum.HumanoidStateType.GettingUp)
                for _, p in ipairs(myChar:GetChildren()) do
                    if p:IsA("BasePart") then
                        p.Velocity    = Vector3.new()
                        p.RotVelocity = Vector3.new()
                    end
                end
                task.wait()
            until (myRoot.Position - getgenv().OldPos.p).Magnitude < 20 or attempts > 30
        end
    end)

    return true
end

-- Проверка: улетел ли игрок
local function DidFling(target)
    local tChar = target.Character
    if not tChar then return true end
    local tRoot = tChar:FindFirstChild("HumanoidRootPart")
    if not tRoot then return true end
    return tRoot.Velocity.Magnitude > 200
end

-- ============================================================
-- Основной цикл
-- ============================================================
local function StartFling()
    if FlingActive then return end
    if CountSelected() == 0 then
        StatusLabel.Text = "❌ Нет выбранных целей!"
        task.wait(1.5)
        UpdateStatus()
        return
    end

    FlingActive = true
    workspace.FallenPartsDestroyHeight = 0/0
    UpdateStatus()
    Notify("💥 Started", "Флингаем " .. CountSelected() .. " целей", 2)

    task.spawn(function()
        while FlingActive do
            local valid = {}
            for name, p in pairs(SelectedTargets) do
                if p and p.Parent then
                    valid[name] = p
                else
                    SelectedTargets[name] = nil
                    local cb = PlayerCheckboxes[name]
                    if cb then
                        cb.Checkmark.Visible = false
                        cb.CB.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
                    end
                end
            end

            for _, p in pairs(valid) do
                if not FlingActive then break end

                local ok = HardFling(p)

                -- Авторефлинг: если не улетел — бьём ещё раз
                if ok and AutoRefling then
                    task.wait(0.3)
                    if not DidFling(p) then
                        HardFling(p)
                    end
                end

                task.wait(0.05)
            end

            UpdateStatus()
            task.wait(math.max(FlingDelay, 0))
        end

        workspace.FallenPartsDestroyHeight = getgenv().FPDH
    end)
end

local function StopFling()
    if not FlingActive then return end
    FlingActive = false
    workspace.FallenPartsDestroyHeight = getgenv().FPDH
    UpdateStatus()
    Notify("■ Stopped", "Флинг остановлен", 2)
end

