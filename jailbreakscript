local alarmPlaying  = false
local CA_INTERVAL   = 0.5
local caLastCheck   = 0

local function getMyPosition()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        return char.HumanoidRootPart.Position
    end
end

local function isCop(player)
    if player.Team then
        local n = player.Team.Name:lower()
        if n:find("police") or n:find("cop") or n:find("officer") then return true end
    end
    local ok, val = pcall(function()
        return player:GetAttribute("Team") or player:GetAttribute("Role")
    end)
    if ok and val then
        local v = tostring(val):lower()
        if v:find("police") or v:find("cop") then return true end
    end
    return false
end

local function caApplySettings()
    local newId = caSoundInput.Text:match("%d+")
    if newId then
        copConfig.soundId   = newId
        copSound.SoundId    = "rbxassetid://" .. newId
    end
    local newR = tonumber(caRadiusInput.Text)
    if newR and newR > 0 then
        copConfig.radius    = newR
        caRadiusLabel.Text  = "Радиус (студов): " .. newR
    end
end

caToggleBtn.MouseButton1Click:Connect(function()
    caApplySettings()
    copConfig.enabled = not copConfig.enabled
    if copConfig.enabled then
        caToggleBtn.Text             = "⏹ ВЫКЛЮЧИТЬ"
        caToggleBtn.BackgroundColor3 = Color3fromRGB(200, 50, 50)
        caStatusLabel.Text           = "Status: ON ✅"
        caStatusLabel.TextColor3     = Color3fromRGB(80, 255, 80)
    else
        caToggleBtn.Text             = "▶ Turn ON"
        caToggleBtn.BackgroundColor3 = Color3fromRGB(60, 60, 80)
        caStatusLabel.Text           = "Status: OFF"
        caStatusLabel.TextColor3     = Color3fromRGB(255, 80, 80)
        caDistLabel.Text             = "Nearest cop: -"
        caDistLabel.TextColor3       = Color3fromRGB(160, 160, 255)
        if alarmPlaying then copSound:Stop(); alarmPlaying = false end
    end
end)

local copAlarmConn = RunService.Heartbeat:Connect(function()
    local now = tick()
    if now - caLastCheck < CA_INTERVAL then return end
    caLastCheck = now

    local myPos = getMyPosition()
    if not myPos then
        caDistLabel.Text   = "Nearest cop: -"
        caDistLabel.TextColor3 = Color3fromRGB(160, 160, 255)
        if alarmPlaying then copSound:Stop(); alarmPlaying = false end
        return
    end

    local closestDist = math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not isCop(player) then continue end
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local d = (char.HumanoidRootPart.Position - myPos).Magnitude
            if d < closestDist then closestDist = d end
        end
    end

    if closestDist == math.huge then
        caDistLabel.Text      = "Nearest cop: not found"
        caDistLabel.TextColor3 = Color3fromRGB(160, 160, 255)
    else
        local dr = math.round(closestDist)
        if copConfig.enabled and closestDist < copConfig.radius then
            caDistLabel.TextColor3 = Color3fromRGB(255, 80, 80)
        elseif copConfig.enabled and closestDist < copConfig.radius * 1.5 then
            caDistLabel.TextColor3 = Color3fromRGB(255, 200, 50)
        else
            caDistLabel.TextColor3 = Color3fromRGB(160, 160, 255)
        end
        caDistLabel.Text = "Nearest cop: " .. dr .. " ст."
    end

    if not copConfig.enabled then
        if alarmPlaying then copSound:Stop(); alarmPlaying = false end
        return
    end

    local nearby = closestDist ~= math.huge and closestDist < copConfig.radius
    if nearby and not alarmPlaying then copSound:Play(); alarmPlaying = true
    elseif not nearby and alarmPlaying then copSound:Stop(); alarmPlaying = false end
end)

_G.CopAlarmConnection = copAlarmConn

