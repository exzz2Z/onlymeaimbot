local function UpdateSlider(inputX)
    local bgPos  = abSliderBg.AbsolutePosition.X
    local bgSize = abSliderBg.AbsoluteSize.X
    local rel    = math.clamp((inputX - bgPos) / bgSize, 0, 1)
    local newR   = math.floor(MIN_FOV + rel * (MAX_FOV - MIN_FOV))
    Environment.FOVSettings.Radius = newR
    abFovLabel.Text  = "FOV Radius: " .. newR
    abSliderFill.Size = UDim2.new(rel, 0, 1, 0)
end

