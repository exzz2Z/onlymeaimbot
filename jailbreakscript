local espConfig = {
    enabled   = false,
    showNames = true,
    showDist  = true,
    teamColor = false,
}

local espObjects = {} -- [player] = {box, nameLabel, distLabel}

local function espGetColor(player)
    if espConfig.teamColor and player.Team then
        return player.Team.TeamColor.Color
    end
    return Color3fromRGB(255, 80, 80)
end

local function espRemove(player)
    if espObjects[player] then
        for _, obj in pairs(espObjects[player]) do
            pcall(function() obj:Remove() end)
        end
        espObjects[player] = nil
    end
end

local function espClear()
    for player in pairs(espObjects) do
        espRemove(player)
    end
end

local function espCreate(player)
    if espObjects[player] then return end

    local box = Drawingnew("Square")
    box.Visible     = false
    box.Thickness   = 1.5
    box.Filled      = false
    box.Color       = espGetColor(player)

    local nameTag = Drawingnew("Text")
    nameTag.Visible  = false
    nameTag.Size     = 13
    nameTag.Center   = true
    nameTag.Outline  = true
    nameTag.Color    = Color3fromRGB(255, 255, 255)
    nameTag.Text     = player.Name

    local distTag = Drawingnew("Text")
    distTag.Visible  = false
    distTag.Size     = 11
    distTag.Center   = true
    distTag.Outline  = true
    distTag.Color    = Color3fromRGB(200, 200, 255)

    espObjects[player] = {box = box, nameTag = nameTag, distTag = distTag}
end

-- Обновление ESP каждый RenderStepped
local espConn = RunService.RenderStepped:Connect(function()
    if not espConfig.enabled then
        for _, objs in pairs(espObjects) do
            objs.box.Visible     = false
            objs.nameTag.Visible = false
            objs.distTag.Visible = false
        end
        return
    end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end

        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")

        if not root or not head then
            if espObjects[player] then
                espObjects[player].box.Visible     = false
                espObjects[player].nameTag.Visible = false
                espObjects[player].distTag.Visible = false
            end
            continue
        end

        espCreate(player)
        local objs = espObjects[player]

        -- Позиции на экране
        local rootSV, rootOn = WorldToViewportPoint(Camera, root.Position)
        local headSV, headOn = WorldToViewportPoint(Camera, head.Position + Vector3.new(0, 0.7, 0))

        if not rootOn then
            objs.box.Visible     = false
            objs.nameTag.Visible = false
            objs.distTag.Visible = false
            continue
        end

        -- Размер бокса через высоту персонажа
        local heightPx = math.abs(headSV.Y - rootSV.Y) * 2.2
        local widthPx  = heightPx * 0.55
        local cx       = rootSV.X
        local cy       = (headSV.Y + rootSV.Y) / 2

        objs.box.Visible   = true
        objs.box.Size      = Vector2new(widthPx, heightPx)
        objs.box.Position  = Vector2new(cx - widthPx / 2, cy - heightPx / 2)
        objs.box.Color     = espGetColor(player)

        -- Имя
        objs.nameTag.Visible   = espConfig.showNames
        objs.nameTag.Position  = Vector2new(cx, cy - heightPx / 2 - 15)
        objs.nameTag.Text      = player.Name

        -- Дистанция
        if espConfig.showDist and myRoot then
            local dist = math.round((root.Position - myRoot.Position).Magnitude)
            objs.distTag.Visible   = true
            objs.distTag.Position  = Vector2new(cx, cy + heightPx / 2 + 2)
            objs.distTag.Text      = dist .. " ст."
        else
            objs.distTag.Visible = false
        end
    end

    -- Чистим вышедших игроков
    for player in pairs(espObjects) do
        if not player or not player.Parent then
            espRemove(player)
        end
    end
end)

Players.PlayerRemoving:Connect(function(player)
    espRemove(player)
end)

