-- FOV Slider
local abSliderDragging = false
local MIN_FOV, MAX_FOV = 30, 600

local function UpdateSlider(inputX)
    local bgPos  = abSliderBg.AbsolutePosition.X
    local bgSize = abSliderBg.AbsoluteSize.X
    local rel    = math.clamp((inputX - bgPos) / bgSize, 0, 1)
    local newR   = math.floor(MIN_FOV + rel * (MAX_FOV - MIN_FOV))
    Environment.FOVSettings.Radius = newR
    abFovLabel.Text  = "FOV Radius: " .. newR
    abSliderFill.Size = UDim2.new(rel, 0, 1, 0)
end

abSliderBg.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        abSliderDragging = true
        UpdateSlider(input.Position.X)
    end
end)
abSliderBg.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        abSliderDragging = false
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if abSliderDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        UpdateSlider(input.Position.X)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        abSliderDragging = false
    end
end)

