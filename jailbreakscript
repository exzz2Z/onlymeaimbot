local GetAllTargets = LPH_NO_VIRTUALIZE(function()
    local Settings  = Environment.Settings
    local LockPart  = Settings.LockPart
    local TCOption  = Environment.DeveloperSettings.TeamCheckOption
    local targets   = {}

    if Settings.AimPlayers then
        for _, Value in next, GetPlayers(Players) do
            local Character = __index(Value, "Character")
            local Humanoid  = Character and FindFirstChildOfClass(Character, "Humanoid")
            if Value ~= LocalPlayer
                and not tablefind(Environment.Blacklisted, __index(Value, "Name"))
                and Character
                and FindFirstChild(Character, LockPart)
                and Humanoid
            then
                if Settings.TeamCheck and __index(Value, TCOption) == __index(LocalPlayer, TCOption) then continue end
                if Settings.AliveCheck and __index(Humanoid, "Health") <= 0 then continue end
                if Settings.WallCheck then
                    local pp = __index(Character[LockPart], "Position")
                    local bl = GetDescendants(__index(LocalPlayer, "Character"))
                    for _, d in next, GetDescendants(Character) do bl[#bl+1] = d end
                    if #GetPartsObscuringTarget(Camera, {pp}, bl) > 0 then continue end
                end
                table.insert(targets, {type="player", object=Value, character=Character})
            end
        end
    end

    if Settings.AimBots then
        local pChars = {}
        for _, p in next, GetPlayers(Players) do
            local c = __index(p, "Character")
            if c then pChars[c] = true end
        end
        for _, obj in next, GetDescendants(workspace) do
            if obj.ClassName == "Humanoid" then
                local char = obj.Parent
                if not pChars[char] then
                    local part = FindFirstChild(char, LockPart) or FindFirstChild(char, "HumanoidRootPart")
                    if part then
                        if Settings.AliveCheck and __index(obj, "Health") <= 0 then continue end
                        if Settings.WallCheck then
                            local pp = __index(part, "Position")
                            local bl = GetDescendants(__index(LocalPlayer, "Character"))
                            if #GetPartsObscuringTarget(Camera, {pp}, bl) > 0 then continue end
                        end
                        table.insert(targets, {type="npc", object=obj, character=char, part=part})
                    end
                end
            end
        end
    end

    return targets
end)

local GetTargetPart = LPH_NO_VIRTUALIZE(function(target)
    if target.type == "player" then
        return FindFirstChild(target.character, Environment.Settings.LockPart)
    else
        return target.part
    end
end)

local GetTargetName = LPH_NO_VIRTUALIZE(function(target)
    if target.type == "player" then return __index(target.object, "Name")
    else return target.character.Name .. " [NPC]" end
end)

local GetClosestTarget = LPH_NO_VIRTUALIZE(function(Aux)
    local FOVSettings = Environment.FOVSettings
    local Settings    = Environment.Settings

    if not Environment.Locked or Aux then
        local ScreenFOV     = FOVSettings.Enabled and FOVSettings.Radius or 2000
        local Best3D        = math.huge
        local BestTarget    = nil
        local CameraPos     = __index(Camera, "CFrame").Position
        local MousePos      = GetMouseLocation(UserInputService)

        for _, target in next, GetAllTargets() do
            local part = GetTargetPart(target)
            if not part then continue end
            local PartPos       = __index(part, "Position")
            local ScreenVec, On = WorldToViewportPoint(Camera, PartPos)
            if not On then continue end
            local Dist2D = (MousePos - Vector2new(ScreenVec.X, ScreenVec.Y)).Magnitude
            if Dist2D > ScreenFOV then continue end
            local D3 = (CameraPos - PartPos).Magnitude
            if D3 < Best3D then Best3D = D3; BestTarget = target end
        end

        if BestTarget then
            if not Aux then
                Environment.Locked   = BestTarget
                abLockLabel.Text      = "Target: " .. GetTargetName(BestTarget)
                abLockLabel.TextColor3 = Color3fromRGB(100, 255, 100)
            elseif not Running and not Environment.Locked then
                return BestTarget
            end
        end
    else
        local locked     = Environment.Locked
        local lockedChar = locked.character or (locked.type == "player" and __index(locked.object, "Character"))
        if not lockedChar or not FindFirstChild(lockedChar, Settings.LockPart) then
            CancelLock(); return
        end
        local LockedPos    = __index(lockedChar[Settings.LockPart], "Position")
        local SV, On       = WorldToViewportPoint(Camera, LockedPos)
        local MousePos     = GetMouseLocation(UserInputService)
        local ScreenFOV    = FOVSettings.Enabled and FOVSettings.Radius or 2000
        if not On or (MousePos - Vector2new(SV.X, SV.Y)).Magnitude > ScreenFOV then
            CancelLock()
        end
    end
end)

local GetClosestPlayer = LPH_NO_VIRTUALIZE(function(Aux) return GetClosestTarget(Aux) end)

