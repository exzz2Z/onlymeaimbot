--  HELPERS
-- ═══════════════════════════════════════════════════════════════
local function CV(v) return Vector2new(v.X, v.Y) end

local function UsesMouseMethod()
    return Settings.AimMethod == "Mouse" and mousemoverel ~= nil
end

-- Точка отсчёта для FOV и выбора цели: курсор при методе Mouse, иначе центр вьюпорта.
local function GetScreenOrigin()
    if UsesMouseMethod() then return GetMouseLocation(UserInputService) end
    return __index(Camera, "ViewportSize") / 2
end

local function GetLocalRoot()
    local char = __index(LocalPlayer, "Character")
    if not char then return nil, nil end
    return FindFirstChildOfClass(char, "Humanoid"), FindFirstChild(char, "HumanoidRootPart")
end

local function ReleaseCharacter()
    local hum = CharState.humanoid
    if hum then
        pcall(function() __newindex(hum, "AutoRotate", CharState.autoRotate) end)
    end
    CharState.humanoid, CharState.autoRotate = nil, nil
end

-- Поворот персонажа только по горизонтали в сторону цели.
local function RotateCharacterToward(targetPos, alpha)
    local hum, root = GetLocalRoot()
    if not hum or not root then return end
    if __index(hum, "Health") <= 0 or __index(hum, "Sit") then return end

    if CharState.humanoid ~= hum then
        ReleaseCharacter()
        CharState.humanoid   = hum
        CharState.autoRotate = __index(hum, "AutoRotate")
    end
    __newindex(hum, "AutoRotate", false)

    local rp   = __index(root, "Position")
    local flat = Vector3new(targetPos.X - rp.X, 0, targetPos.Z - rp.Z)
    if flat.Magnitude < 0.05 then return end
    local goal = CFramenew(rp, rp + flat)
    __newindex(root, "CFrame", __index(root, "CFrame"):Lerp(goal, alpha))
end

local function CancelLock()
    Locked = nil
    MouseRemainder = Vector2new(0, 0)
    __newindex(UserInputService, "MouseDeltaSensitivity", OriginalSensitivity)
    ReleaseCharacter()
    if ActiveAnimation then ActiveAnimation:Cancel(); ActiveAnimation = nil end
    setrenderproperty(FOVCircle, "Color", Settings.FOVColor)
end

local function GetTargetPart(target)
    if target.type == "player" then
        return FindFirstChild(target.character, Settings.LockPart)
            or FindFirstChild(target.character, "HumanoidRootPart")
    else
        return target.part
    end
end

local function GetTargetName(target)
    if target.type == "player" then return __index(target.object, "Name") end
    return target.character.Name .. " [NPC]"
end

-- ── Сбор целей ───────────────────────────────────────────────
local function GetAllTargets()
    local targets = {}
    local TCOption = "TeamColor"

    if Settings.AimPlayers then
        for _, plr in next, GetPlayers(Players) do
            if plr == LocalPlayer then continue end
            local char = __index(plr,"Character")
            local hum  = char and FindFirstChildOfClass(char,"Humanoid")
            if not char or not hum then continue end
            if not FindFirstChild(char, Settings.LockPart) then continue end
            if Settings.TeamCheck then
                if __index(plr,TCOption) == __index(LocalPlayer,TCOption) then continue end
            end
            if Settings.AliveCheck and __index(hum,"Health") <= 0 then continue end
            if Settings.WallCheck then
                local part = FindFirstChild(char, Settings.LockPart)
                if part then
                    local pp = __index(part,"Position")
                    local bl = GetDescendants(__index(LocalPlayer,"Character"))
                    for _, d in next, GetDescendants(char) do bl[#bl+1] = d end
                    if #GetPartsObscuringTarget(Camera,{pp},bl) > 0 then continue end
                end
            end
            table.insert(targets, {type="player", object=plr, character=char})
        end
    end

    if Settings.AimBots then
        local now = tick()
        if now - npcCacheTime > NPC_CACHE_TTL then
            npcCacheTime = now; npcCache = {}
            local pChars = {}
            for _, p in next, GetPlayers(Players) do
                local c = __index(p,"Character")
                if c then pChars[c] = true end
            end
            for _, obj in next, GetDescendants(workspace) do
                if obj.ClassName == "Humanoid" then
                    local ch   = obj.Parent
                    if pChars[ch] then continue end
                    local part = FindFirstChild(ch, Settings.LockPart)
                           or   FindFirstChild(ch, "HumanoidRootPart")
                    if part then
                        table.insert(npcCache,{type="npc",object=obj,character=ch,part=part})
                    end
                end
            end
        end
        for _, t in next, npcCache do
            if Settings.AliveCheck then
                if not t.object or not t.object.Parent then continue end
                if __index(t.object,"Health") <= 0 then continue end
            end
            if Settings.WallCheck then
                if not t.part or not t.part.Parent then continue end
                local pp = __index(t.part,"Position")
                local bl = GetDescendants(__index(LocalPlayer,"Character"))
                if #GetPartsObscuringTarget(Camera,{pp},bl) > 0 then continue end
            end
            table.insert(targets, t)
        end
    end

    return targets
end

-- ── Поиск ближайшей цели в FOV ───────────────────────────────
local function GetClosestTarget()
    local fovR   = Settings.FOVRadius > 0 and Settings.FOVRadius or 9999
    local origin = GetScreenOrigin()
    local _, localRoot = GetLocalRoot()
    local refPos = localRoot and __index(localRoot, "Position")
                   or __index(Camera, "CFrame").Position
    local bestScore, bestTarget = math.huge, nil

    for _, target in next, GetAllTargets() do
        local part = GetTargetPart(target)
        if not part then continue end
        local pos = __index(part, "Position")
        local sv  = WorldToViewportPoint(Camera, pos)
        if sv.Z <= 0 then continue end
        local screenDist = (origin - Vector2new(sv.X, sv.Y)).Magnitude
        if screenDist > fovR then continue end

        local score
        if Settings.TargetMode == "ScreenCenter" then
            score = screenDist
        else
            score = (refPos - pos).Magnitude
        end
        if score < bestScore then
            bestScore, bestTarget = score, target
        end
    end
    return bestTarget
end

local function AimWithCamera(targetPos, alpha)
    local goal = CFramenew(__index(Camera, "CFrame").Position, targetPos)
    if Settings.Sensitivity > 0 then
        if ActiveAnimation then ActiveAnimation:Cancel() end
        ActiveAnimation = TweenService:Create(
            Camera,
            TweenInfonew(Settings.Sensitivity, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
            {CFrame = goal}
        )
        ActiveAnimation:Play()
    else
        __newindex(Camera, "CFrame", goal)
    end
    __newindex(UserInputService, "MouseDeltaSensitivity", 0)

    if Settings.RotateCharacter then
        RotateCharacterToward(targetPos, alpha)
    else
        ReleaseCharacter()
    end
end

-- Замкнутый контур: каждый кадр заново меряем экранное смещение цели.
-- Дробную часть копим в MouseRemainder, чтобы не терять субпиксельные шаги.
local function AimWithMouse(targetPos, alpha)
    local sv = WorldToViewportPoint(Camera, targetPos)
    if sv.Z <= 0 then return end
    local origin = GetMouseLocation(UserInputService)
    local want = (Vector2new(sv.X, sv.Y) - origin) * (alpha * Settings.MouseGain) + MouseRemainder
    local sx = want.X >= 0 and mathfloor(want.X) or mathceil(want.X)
    local sy = want.Y >= 0 and mathfloor(want.Y) or mathceil(want.Y)
    MouseRemainder = Vector2new(want.X - sx, want.Y - sy)
    if sx ~= 0 or sy ~= 0 then mousemoverel(sx, sy) end
end

local function AimbotStep(dt)
    if Locked then
        local lockedChar = Locked.character
            or (Locked.type == "player" and __index(Locked.object, "Character"))
        local part = GetTargetPart(Locked)
        if not lockedChar or not part or not part.Parent then
            CancelLock(); return
        end
        local fovR   = Settings.FOVRadius > 0 and Settings.FOVRadius or 9999
        local origin = GetScreenOrigin()
        local sv     = WorldToViewportPoint(Camera, __index(part, "Position"))
        if sv.Z <= 0 or (origin - Vector2new(sv.X, sv.Y)).Magnitude > fovR then
            CancelLock(); return
        end
    else
        Locked = GetClosestTarget()
        if not Locked then return end
    end

    local part = GetTargetPart(Locked)
    if not part then CancelLock(); return end
    local targetPos = __index(part, "Position")
    local alpha = Settings.Sensitivity > 0
        and mathclamp(dt / Settings.Sensitivity, 0, 1) or 1

    if UsesMouseMethod() then
        AimWithMouse(targetPos, alpha)
    else
        AimWithCamera(targetPos, alpha)
    end
    setrenderproperty(FOVCircle, "Color", Settings.FOVLockedColor)
end

