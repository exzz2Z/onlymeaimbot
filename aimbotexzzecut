local function isKeyMatch(inp)
    local tk = Settings.TriggerKey
    if typeof(tk) == "EnumItem" then
        if tk.EnumType == Enum.UserInputType then
            return inp.UserInputType == tk
        else
            -- KeyCode
            return inp.UserInputType == Enum.UserInputType.Keyboard and inp.KeyCode == tk
        end
    end
    return false
end

ServiceConnections.InputBegan = UserInputService.InputBegan:Connect(function(inp, gpe)
    if Typing or gpe then return end
    if not isKeyMatch(inp) then return end
    if Settings.HoldMode then
        Running = true
    else
        Running = not Running
        if not Running then CancelLock() end
    end
end)

ServiceConnections.InputEnded = UserInputService.InputEnded:Connect(function(inp)
    if Typing then return end
    if not isKeyMatch(inp) then return end
    if Settings.HoldMode then
        Running = false
        CancelLock()
    end
end)

ServiceConnections.TypingOn  = UserInputService.TextBoxFocused:Connect(function()    Typing=true  end)
ServiceConnections.TypingOff = UserInputService.TextBoxFocusReleased:Connect(function() Typing=false end)

-- ═══════════════════════════════════════════════════════════════
--  MAIN RENDER LOOP
-- ═══════════════════════════════════════════════════════════════
local function OnRender(dt)
    local origin = GetScreenOrigin()
    local fovR   = Settings.FOVRadius

    local showFov = Settings.Enabled and Settings.FOVVisible
    setrenderproperty(FOVCircle,        "Visible", showFov)
    setrenderproperty(FOVCircleOutline, "Visible", showFov)
    if showFov then
        setrenderproperty(FOVCircle,        "Radius",   fovR)
        setrenderproperty(FOVCircleOutline, "Radius",   fovR)
        setrenderproperty(FOVCircle,        "Position", origin)
        setrenderproperty(FOVCircleOutline, "Position", origin)
        setrenderproperty(FOVCircle, "Color",
            Locked and Settings.FOVLockedColor or Settings.FOVColor)
        setrenderproperty(FOVCircleOutline, "Color",     Settings.FOVOutlineColor)
        setrenderproperty(FOVCircleOutline, "Thickness", 2)
    end

    if Settings.Enabled and Running then
        AimbotStep(dt)
    elseif Locked then
        CancelLock()
    end

    if Settings.TracerEnabled and Settings.Enabled then
        local tracerTarget = Locked or (Running and GetClosestTarget())
        local part = tracerTarget and GetTargetPart(tracerTarget)
        local sv = part and WorldToViewportPoint(Camera, __index(part, "Position"))
        if sv and sv.Z > 0 then
            setrenderproperty(Tracer, "Visible",      true)
            setrenderproperty(Tracer, "Color",        Settings.TracerColor)
            setrenderproperty(Tracer, "Thickness",    Settings.TracerThickness)
            setrenderproperty(Tracer, "Transparency", 0.4)
            setrenderproperty(Tracer, "From",         origin)
            setrenderproperty(Tracer, "To",           Vector2new(sv.X, sv.Y))
        else
            setrenderproperty(Tracer, "Visible", false)
        end
    else
        setrenderproperty(Tracer, "Visible", false)
    end

    if Locked then
        targetLbl.Text       = "Target: " .. GetTargetName(Locked)
        targetLbl.TextColor3 = Color3fromRGB(100,255,100)
    else
        targetLbl.Text       = "Target: —"
        targetLbl.TextColor3 = Color3fromRGB(140,140,180)
    end
end

RunService:BindToRenderStep(RENDER_BIND_NAME, Enum.RenderPriority.Camera.Value + 1, OnRender)

