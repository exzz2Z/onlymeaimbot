local function rebuildSelected()
    for _, c in ipairs(selectedFrame:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end

    local count = 0
    for uid, _ in pairs(ESP.Selected) do
        local player = Players:GetPlayerByUserId(uid)
        local name = player and player.Name or ("ID:" .. uid)
        count += 1

        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 24)
        row.BackgroundTransparency = 1
        row.LayoutOrder = count
        row.Parent = selectedFrame

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size = UDim2.new(1, -28, 1, 0)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text = "  " .. name
        nameLbl.TextColor3 = Color3.fromRGB(100, 220, 130)
        nameLbl.Font = Enum.Font.Gotham
        nameLbl.TextSize = 12
        nameLbl.TextXAlignment = Enum.TextXAlignment.Left
        nameLbl.Parent = row

        local removeBtn = Instance.new("TextButton")
        removeBtn.Size = UDim2.new(0, 22, 0, 18)
        removeBtn.Position = UDim2.new(1, -24, 0.5, -9)
        removeBtn.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
        removeBtn.Text = "✕"
        removeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        removeBtn.Font = Enum.Font.GothamBold
        removeBtn.TextSize = 11
        removeBtn.BorderSizePixel = 0
        removeBtn.Parent = row

        local rc = Instance.new("UICorner")
        rc.CornerRadius = UDim.new(0, 4)
        rc.Parent = removeBtn

        removeBtn.MouseButton1Click:Connect(function()
            ESP.Selected[uid] = nil
            removeESP(player)
            rebuildSelected()
            if ESP.Mode == "Selected" then refreshAllESP() end
        end)
    end

    selectedFrame.CanvasSize = UDim2.new(0, 0, 0, count * 24)
end

_G.CapyRebuildSelected = rebuildSelected
