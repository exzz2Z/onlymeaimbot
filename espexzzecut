dropList.Parent = dropScroll

local dropLayout = Instance.new("UIListLayout")
dropLayout.SortOrder = Enum.SortOrder.LayoutOrder
dropLayout.Parent = dropList

local dropOpen = false

local function rebuildDropdown()
    for _, c in ipairs(dropList:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end

    local players = Players:GetPlayers()
    local count = 0
    for _, p in ipairs(players) do
        if p ~= LocalPlayer then
            count += 1
            local item = Instance.new("TextButton")
            item.Size = UDim2.new(1, 0, 0, 24)
            item.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
            item.Text = "  " .. p.Name
            item.TextColor3 = Color3.fromRGB(210, 210, 230)
            item.Font = Enum.Font.Gotham
            item.TextSize = 12
            item.TextXAlignment = Enum.TextXAlignment.Left
            item.BorderSizePixel = 0
            item.LayoutOrder = count
            item.Parent = dropList

            item.MouseButton1Click:Connect(function()
                if not ESP.Selected[p.UserId] then
                    ESP.Selected[p.UserId] = true
                    dropOpen = false
                    -- Схлопываем дропдаун
                    dropScroll.Size = UDim2.new(1, 0, 0, 0)
                    dropFrame.Size = UDim2.new(1, 0, 0, 28)
                    dropBtn.Text = "▼ Выбрать игрока"
                    refreshAllESP()
                    _G.CapyRebuildSelected()
                end
            end)
        end
    end

    local totalHeight = count * 24
    local scrollHeight = math.min(totalHeight, MAX_DROPDOWN_HEIGHT)

    dropList.Size = UDim2.new(1, -6, 0, totalHeight)
    dropScroll.CanvasSize = UDim2.new(0, 0, 0, totalHeight)

    if dropOpen then
        dropScroll.Size = UDim2.new(1, 0, 0, scrollHeight)
        dropFrame.Size = UDim2.new(1, 0, 0, 28 + scrollHeight)
    else
        dropScroll.Size = UDim2.new(1, 0, 0, 0)
        dropFrame.Size = UDim2.new(1, 0, 0, 28)
    end
end

dropBtn.MouseButton1Click:Connect(function()
    dropOpen = not dropOpen
    rebuildDropdown()
    dropBtn.Text = dropOpen and "▲ Выбрать игрока" or "▼ Выбрать игрока"
end)

