local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- ===================== CONFIG =====================
local ESP = {
    Enabled = false,
    Mode = "All", -- "All" or "Selected"
    Selected = {}, -- { [userId] = true }
    Objects = {}, -- { [userId] = { highlight, billboardGui, healthBar } }
    HighlightColor = Color3.fromRGB(255, 50, 50),
    OutlineColor = Color3.fromRGB(255, 255, 255),
}

-- ===================== ESP CORE =====================

local function removeESP(player)
    local obj = ESP.Objects[player.UserId]
    if obj then
        if obj.highlight and obj.highlight.Parent then obj.highlight:Destroy() end
        if obj.billboard and obj.billboard.Parent then obj.billboard:Destroy() end
        if obj.healthGui and obj.healthGui.Parent then obj.healthGui:Destroy() end
        ESP.Objects[player.UserId] = nil
    end
end

local function createESP(player)
    if player == LocalPlayer then return end

    local char = player.Character
    if not char then return end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart then return end

    -- Убираем старый если есть
    removeESP(player)

    -- === Highlight ===
    local highlight = Instance.new("Highlight")
    highlight.FillColor = ESP.HighlightColor
    highlight.OutlineColor = ESP.OutlineColor
    highlight.FillTransparency = 0.4
    highlight.OutlineTransparency = 0
    highlight.Adornee = char
    highlight.Parent = char

    -- === BillboardGui (имя) ===
    local billboard = Instance.new("BillboardGui")
    billboard.Adornee = rootPart
    billboard.Size = UDim2.new(0, 120, 0, 30)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = char

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 1, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 14
    nameLabel.Parent = billboard

    -- === HealthBar (вертикальная полоска слева от хайлайта) ===
    local healthGui = Instance.new("BillboardGui")
    healthGui.Adornee = rootPart
    healthGui.Size = UDim2.new(0, 6, 0, 60)
    healthGui.StudsOffset = Vector3.new(-1.4, 0, 0)
    healthGui.AlwaysOnTop = true
    healthGui.Parent = char

    local bgBar = Instance.new("Frame")
    bgBar.Size = UDim2.new(1, 0, 1, 0)
    bgBar.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    bgBar.BorderSizePixel = 0
    bgBar.Parent = healthGui

    local hpBar = Instance.new("Frame")
    hpBar.Size = UDim2.new(1, 0, 1, 0)
    hpBar.AnchorPoint = Vector2.new(0, 1)
    hpBar.Position = UDim2.new(0, 0, 1, 0)
    hpBar.BackgroundColor3 = Color3.fromRGB(80, 220, 80)
    hpBar.BorderSizePixel = 0
    hpBar.Parent = bgBar

    -- Апдейт HP каждый фрейм
    RunService.Heartbeat:Connect(function()
        if not humanoid or not humanoid.Parent then return end
        local pct = humanoid.Health / math.max(humanoid.MaxHealth, 1)
        hpBar.Size = UDim2.new(1, 0, pct, 0)
        -- Цвет: зелёный -> красный
        hpBar.BackgroundColor3 = Color3.fromRGB(
            math.floor((1 - pct) * 220),
            math.floor(pct * 220),
            50
        )
    end)

    ESP.Objects[player.UserId] = {
        highlight = highlight,
        billboard = billboard,
        healthGui = healthGui,
    }
end

local function shouldShow(player)
    if not ESP.Enabled then return false end
    if player == LocalPlayer then return false end
    if not player.Character then return false end
    if ESP.Mode == "All" then return true end
    if ESP.Mode == "Selected" then return ESP.Selected[player.UserId] == true end
    return false
end

local function refreshAllESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if shouldShow(player) then
            if not ESP.Objects[player.UserId] then
                createESP(player)
            end
        else
            removeESP(player)
        end
    end
end

-- Следим за персонажем
local function watchPlayer(player)
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        if shouldShow(player) then
            createESP(player)
        end
    end)
    player.CharacterRemoving:Connect(function()
        removeESP(player)
    end)
end

for _, p in ipairs(Players:GetPlayers()) do watchPlayer(p) end
Players.PlayerAdded:Connect(watchPlayer)
Players.PlayerRemoving:Connect(function(p) removeESP(p) end)

